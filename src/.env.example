# 필수: 32자 이상의 무작위 관리자 토큰을 입력하세요.
OPERATOR_TOKEN=

# 선택: 비워 두면 실행 기준 폴더(src)의 workspace·data, 현재 사용자 ~/.codex를 사용합니다.
# 기본 workspace·data는 시작 시 자동 생성하며 인증 폴더는 생성하지 않습니다.
# 지정할 때는 실제 존재하는 절대 경로를 입력하세요.
WORKSPACE_ROOT=
CODEX_HOME=
DB_PATH=

PORT=3000
# 내부 MCP 브리지 전용. 웹 PORT와 달라야 하며 127.0.0.1에만 바인딩합니다.
MCP_PORT=3001
# 외부 AI 관리 MCP(Streamable HTTP /mcp). 기존 두 포트와 달라야 합니다.
ADMIN_MCP_PORT=3002
# 별도 무작위 토큰(32자 이상 URL-safe 문자). 비어 있으면 관리 MCP를 열지 않습니다.
# 이 토큰은 직원 생성·정책·권한 변경 등 운영자 수준의 접근 권한입니다.
ADMIN_MCP_TOKEN=
HOST=127.0.0.1
# 기본값 codex는 Windows에서 native codex.exe로 해석합니다.
# 자동으로 찾지 못하면 codex.exe의 절대 경로를 지정하세요(.cmd/.ps1 사용 금지).
CODEX_BIN=codex
MODEL_CHOICES=gpt-6.1-sol
# 비워 두면 위에서 선택한 CODEX_HOME/sessions를 사용합니다.
LOG_SOURCE_ROOT=

# 사내 정책과 종료 사유를 확인하기 전에는 false로 유지하세요.
AUTO_RESUME_ENABLED=false
# 허용된 일시 종료 코드를 쉼표로 구분해 지정하세요. 비워 두면 자동 재개하지 않습니다.
RETRYABLE_EXIT_CODES=
MAX_RETRIES=3
# 첫 실행을 제외한 재개 횟수의 상한입니다. 0이면 재개하지 않습니다.
MAX_CONCURRENT_RUNS=2
MAX_RUN_HOURS=4
