# 필수: 32자 이상의 무작위 관리자 토큰을 입력하세요.
OPERATOR_TOKEN=

# 필수: 호스트에 존재하는 디렉터리를 절대 경로로 지정하세요.
WORKSPACE_HOST_PATH=D:/ai_work
CODEX_HOME_HOST=C:/Users/nowonbun/.codex
DATA_HOST_PATH=D:/ai_work_data

PORT=3000
HOST=0.0.0.0
CODEX_BIN=codex
MODEL_CHOICES=gpt-6.1-sol
LOG_SOURCE_ROOT=/codex-home/sessions

# 사내 정책과 종료 사유를 확인하기 전에는 false로 유지하세요.
AUTO_RESUME_ENABLED=false
# 허용된 일시 종료 코드를 쉼표로 구분해 지정하세요. 비워 두면 자동 재개하지 않습니다.
RETRYABLE_EXIT_CODES=
MAX_RETRIES=3
# 첫 실행을 제외한 재개 횟수의 상한입니다. 0이면 재개하지 않습니다.
MAX_CONCURRENT_RUNS=2
MAX_RUN_HOURS=4
